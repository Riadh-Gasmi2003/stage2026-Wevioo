<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="certificat_non_opposition" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              resourceBundle="reports.reports_messages">

    <parameter name="NUMERO_PERMIS" class="java.lang.String"/>
    <parameter name="NOM_PETITIONNAIRE" class="java.lang.String"/>
    <parameter name="DATE_DELIVRANCE" class="java.lang.String"/>
    <parameter name="DATE_ECHEANCE_LEGALE" class="java.lang.String"/>
    <parameter name="NUMERO_DOSSIER" class="java.lang.String"/>
    <parameter name="COMMUNE" class="java.lang.String"/>

    <title>
        <band height="500">
            <textField>
                <reportElement x="0" y="0" width="535" height="20"/>
                <textElement textAlignment="Center"><font fontName="FreeSerif" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{report.republiqueTunisienne}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="535" height="20"/>
                <textElement textAlignment="Center"><font fontName="FreeSerif" size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{certificat.communeHeader}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="60" width="535" height="30"/>
                <textElement textAlignment="Center"><font fontName="FreeSerif" size="15" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{certificat.title}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="90" width="535" height="20"/>
                <textElement textAlignment="Center"><font fontName="FreeSerif" size="10" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$R{certificat.subtitle}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="150" width="200" height="20"/>
                <textElement><font fontName="FreeSerif" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{report.numeroDossierLabel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="150" width="335" height="20"/>
                <textFieldExpression><![CDATA[$P{NUMERO_DOSSIER}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="180" width="200" height="20"/>
                <textElement><font fontName="FreeSerif" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{certificat.numeroCertificatLabel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="180" width="335" height="20"/>
                <textFieldExpression><![CDATA[$P{NUMERO_PERMIS}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="210" width="200" height="20"/>
                <textElement><font fontName="FreeSerif" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{report.petitionnaireLabel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="210" width="335" height="20"/>
                <textFieldExpression><![CDATA[$P{NOM_PETITIONNAIRE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="240" width="200" height="20"/>
                <textElement><font fontName="FreeSerif" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{report.communeLabel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="240" width="335" height="20"/>
                <textFieldExpression><![CDATA[$P{COMMUNE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="270" width="200" height="20"/>
                <textElement><font fontName="FreeSerif" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{certificat.delaiExpireLabel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="270" width="335" height="20"/>
                <textFieldExpression><![CDATA[$P{DATE_ECHEANCE_LEGALE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="310" width="535" height="60"/>
                <textElement><paragraph lineSpacing="Single"/></textElement>
                <textFieldExpression><![CDATA[$R{certificat.body}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="400" width="200" height="20"/>
                <textElement><font fontName="FreeSerif" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{report.dateDelivranceLabel}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="400" width="335" height="20"/>
                <textFieldExpression><![CDATA[$P{DATE_DELIVRANCE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="460" width="535" height="30"/>
                <textElement textAlignment="Center"><font fontName="FreeSerif" size="7" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$R{report.footerLegal}]]></textFieldExpression>
            </textField>
        </band>
    </title>
</jasperReport>
