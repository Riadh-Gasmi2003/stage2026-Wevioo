              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="permis_batir" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              resourceBundle="reports.reports_messages">

    <!-- Un même gabarit sert les deux langues (REPORT_LOCALE pilote $R{...}, voir
         JasperReportService). Pour l'arabe, chaque ligne libellé/valeur est dupliquée
         en miroir (libellé à droite, valeur à gauche, texte aligné à droite, sens de
         lecture RTL) et affichée uniquement quand REPORT_LOCALE = ar ; la version
         française d'origine reste inchangée et n'est affichée que pour REPORT_LOCALE = fr.
         Les blocs centrés (titres, pied de page, bloc signature) n'ont pas besoin d'être
         dupliqués : leur position ne change pas d'une langue à l'autre. -->

